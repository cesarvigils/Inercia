# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the real .env file — it is already covered by .gitignore.

# ---------------------------------------------------------------
# Firebase client SDK (public, exposed to the browser via Vite)
# Get these from Firebase Console > Project settings > General
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Firebase Admin SDK (server-only, used by /api functions)
# From a service account key: Firebase Console > Project settings
# > Service accounts > Generate new private key
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences and surrounding quotes as one line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------
# PayPal (server-only)
# From developer.paypal.com > Apps & Credentials
# ---------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_HNL_USD_RATE=
# Membership (unlocks cash payment). Plan ID(s) from PayPal, the ones that
# start with P- (not PROD-). Several plans (monthly, yearly...) go comma
# separated; the first is the default. Setup: documentation/membership-setup.md
#
# The live "Inercia Membresias" plans, 3 tiers x 4 billing periods
# named "Plan <Tier> 1" (monthly), "Plan <Tier> 3" (trimestral),
# "Plan <Tier> 6" (semestral) and plain "Plan <Tier>" (anual). The tier
# (Gold / Platino / Zafiro) comes from each plan's name in PayPal and the
# billing period from its billing cycle, so a plan's PayPal name, not its
# order here, decides how it is shown. Listed Gold, Platino, Zafiro, each
# 1 / 3 / 6 / anual. Transcribed from a PayPal dashboard screenshot on
# 2026-11-26: compare against PayPal before pasting into Vercel.
PAYPAL_MEMBERSHIP_PLAN_ID=P-7SX097223U301794UNMEGE7Q,P-7WU49170TD4268801NMEGGSY,P-96W401964B000791TNMEGHDI,P-49P03691U2806872KNMEGEPQ,P-76268634YV6178919NMEGH3I,P-0XF33695VC334634ANMEGIGQ,P-3VJ41954EG167802PNMEGISA,P-3KU04484UC7270006NMEGHRQ,P-13F259573R837083FNMEGKBQ,P-1T723443GS982353MNMEGKJY,P-90Y696997H3580704NMEGKUQ,P-90538310776865251NMEGJNI
# Public site origin, used for PayPal's return/cancel links when a buyer
# approves a membership by redirect (e.g. https://inerciahn.com).
SITE_URL=

# ---------------------------------------------------------------
# Google Sheets standings (server-only, used by api/standings.js)
# SPREADSHEET_ID is the id from the sheet's URL; GOOGLE_SHEETS_API_KEY
# is a Google Cloud API key with the Sheets API enabled, scoped to a
# public/shared spreadsheet (read-only, no OAuth).
# ---------------------------------------------------------------
SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=
# Optional: car shown on /standings ("AUTO:"). Empty = "F1 2025".
STANDINGS_CAR=

# ---------------------------------------------------------------
# Cron (server-only): api/cron/cleanup-proofs.js deletes bank-transfer
# proofs older than PROOF_MAX_AGE_DAYS (default 60) every day at 3:00 a. m.
# Honduras. Vercel sends CRON_SECRET with each cron call; without it the
# route refuses to run. Any long random string (e.g. `openssl rand -hex 32`).
# ---------------------------------------------------------------
CRON_SECRET=
PROOF_MAX_AGE_DAYS=60

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
NODE_ENV=development
