# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the real .env file — it is already covered by .gitignore.

# ---------------------------------------------------------------
# Firebase client SDK (public, exposed to the browser via Vite)
# Get these from Firebase Console > Project settings > General
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Firebase Admin SDK (server-only, used by /api functions)
# From a service account key: Firebase Console > Project settings
# > Service accounts > Generate new private key
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences and surrounding quotes as one line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------
# PayPal (server-only)
# From developer.paypal.com > Apps & Credentials
# ---------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_HNL_USD_RATE=
# Membership (unlocks cash payment). Plan ID(s) from PayPal, the ones that
# start with P- (not PROD-). Several plans (monthly, yearly...) go comma
# separated; the first is the default. Setup: documentation/membership-setup.md
PAYPAL_MEMBERSHIP_PLAN_ID=
# Public site origin, used for PayPal's return/cancel links when a buyer
# approves a membership by redirect (e.g. https://inerciahn.com).
SITE_URL=

# ---------------------------------------------------------------
# Google Sheets standings (server-only, used by api/standings.js)
# SPREADSHEET_ID is the id from the sheet's URL; GOOGLE_SHEETS_API_KEY
# is a Google Cloud API key with the Sheets API enabled, scoped to a
# public/shared spreadsheet (read-only, no OAuth).
# ---------------------------------------------------------------
SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
NODE_ENV=development
