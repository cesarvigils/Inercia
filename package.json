{
  "name": "inercia-pc-fleet",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight LAN-only monitoring and shutdown dashboard for Simuladores Inercia",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node tools/mock-fleet.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:server-exe": "pkg . --targets node22-win-x64 --no-bytecode --public --output dist/server/InerciaFleetServer.exe"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "config.example.json"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
