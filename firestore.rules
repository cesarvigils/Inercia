rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function isAdmin(){ return signedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true; }
  match /adminUsers/{uid}{ allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  match /reservations/{id}{ allow read,update: if isAdmin(); }
  match /reservationLocks/{id}{ allow read,delete: if isAdmin(); }
  match /rigs/{id}{ allow read,write: if isAdmin(); }
  match /sales/{id}{ allow read,write: if isAdmin(); }
  match /products/{id}{ allow read,write: if isAdmin(); }
  match /settings/{id}{ allow read,write: if isAdmin(); }
}}
